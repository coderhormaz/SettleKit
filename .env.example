# Local Next.js app and worker; use a dedicated Neon development branch.
APP_ORIGIN=http://127.0.0.1:3000
ALLOW_LOCAL_HTTP=true
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Dedicated isolated integration-test branch; never a customer/shared default DB.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
TEST_DATABASE_ISOLATED=false
STORE_DATABASE_URL=
# 32 random bytes encoded as 64 hex characters; server-only.
DATA_ENCRYPTION_KEY=
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
SCREENING_MAX_SOURCE_AGE_SECONDS=7200
SCREENING_REFRESH_SECONDS=3600
SCREENING_DECISION_SECONDS=120
# Optional sponsor feasibility credentials; never NEXT_PUBLIC_ secrets.
ARKIV_WRITER_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
