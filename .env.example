# Local Next.js app and worker; use a dedicated Neon development branch.
APP_ORIGIN=http://127.0.0.1:3000
ALLOW_LOCAL_HTTP=true
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Dedicated isolated integration-test branch; never a customer/shared default DB.
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=
TEST_DATABASE_ISOLATED=false
STORE_DATABASE_URL=
STORE_DATABASE_URL_UNPOOLED=
TEST_STORE_DATABASE_URL=
TEST_STORE_DATABASE_URL_UNPOOLED=
STORE_ORIGIN=http://127.0.0.1:3200
STORE_GATEWAY_API_KEY=
STORE_WEBHOOK_SECRET=
STORE_ORDER_READ_KEY=
# 32 random bytes encoded as 64 hex characters; server-only.
DATA_ENCRYPTION_KEY=
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
# Set only from verified deployment evidence; absent means checkout is disabled.
WHITECHAIN_ROUTER_ADDRESS=
WHITECHAIN_ROUTER_CODE_HASH=
WHITECHAIN_ROUTER_DEPLOYMENT_BLOCK=
PAYMENT_AUTHORIZER_PRIVATE_KEY=
POLICY_ADMIN_PRIVATE_KEY=
WHITECHAIN_DEPLOYER_PRIVATE_KEY=
POLICY_ADMIN_ADDRESS=
AUTHORIZATION_SIGNER_ADDRESS=
SCREENING_MAX_SOURCE_AGE_SECONDS=7200
SCREENING_REFRESH_SECONDS=3600
SCREENING_DECISION_SECONDS=120
# Optional sponsor feasibility credentials; never NEXT_PUBLIC_ secrets.
ARKIV_WRITER_PRIVATE_KEY=
ARKIV_ACCESS_KEY=
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network

# Buyer gas sponsorship (relayer pays WBT). Keep relayer key server-only.
SPONSOR_BUYER_GAS=false
SPONSOR_RELAYER_PRIVATE_KEY=

# Operator-only CRE recovery; never expose these in browser configuration.
RECOVERY_SERVICE_TOKEN=
CRE_MERCHANT_WALLET=
ARKIV_PUBLIC_WRITER_ADDRESS=
# Explicit local demo failure injection, disabled by default.
ALLOW_DEVELOPMENT_FAILURES=false
STORE_DEVELOPMENT_FAILURE_TOKEN=
# Optional installed PostgreSQL17 tools and dedicated isolated restore database.
PG_DUMP_PATH=
PG_RESTORE_PATH=
PGSSLROOTCERT=
RESTORE_DATABASE_URL_UNPOOLED=
# Override only for explicitly installed tools on another platform.
CRE_CLI_PATH=
BUN_PATH=
DEVELOPMENT_DELIVERY_ATTEMPTS=5
