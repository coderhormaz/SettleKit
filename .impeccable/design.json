      "css": ".ds-ghost{width:44px;height:44px;display:grid;place-items:center;border:0;border-radius:6px;color:var(--muted,#a5adbd);background:transparent;cursor:pointer;transition:background 150ms ease-out}.ds-ghost:hover:not(:disabled){background:#242c35;color:var(--text,#f5f7fa)}.ds-ghost:focus-visible{outline:2px solid var(--mint,#a3f5c5);outline-offset:5px}.ds-ghost:active:not(:disabled){transform:translateY(1px)}.ds-ghost:disabled{opacity:.5;cursor:not-allowed}"
