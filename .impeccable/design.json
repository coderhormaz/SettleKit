      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:42px;padding:11px 16px;border:1px solid transparent;border-radius:7px;background:var(--mint,#a3f5c5);color:var(--mint-ink,#11291b);font-family:var(--font-sans,Manrope,sans-serif);font-size:13px;font-weight:750;cursor:pointer;transition:background 150ms ease-out,opacity 150ms ease-out}.ds-button-primary:hover:not(:disabled){background:#c1fbd9}.ds-button-primary:focus-visible{outline:2px solid var(--mint,#a3f5c5);outline-offset:5px}.ds-button-primary:active:not(:disabled){transform:translateY(1px)}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}"
