  "narrative": {
    "northStar": "A clear operating workspace",
    "overview": "The implemented system follows the user's graphite-and-mint fintech brief. Its expression comes from an aligned working shell, readable forms, controlled density and precise feedback. The work surface leads; supporting explanations describe ownership, screening limits and the test environment without competing with the task.\n\nThis is a scan of the Phase 1 onboarding implementation, not a speculative dashboard library. Future screens inherit its palette, type and control grammar while choosing layouts appropriate to their own jobs. Route-specific onboarding composition remains in `docs/design/onboarding.md`.",
    "keyCharacteristics": [
      "Graphite layers and restrained mint actions.",
      "Real operational state with explicit unavailable and review outcomes.",
      "Familiar controls, clear alignment and readable identifiers.",
      "Border-defined surfaces, without decorative glow or shadows."
    ],
    "rules": [
      {
        "name": "The State Is Evidence Rule",
        "body": "Positive color is conditional on current successful application state; stale or failed reads cannot retain a fresh allowed appearance.",
        "section": "colors"
      },
      {
        "name": "The Operational Type Rule",
        "body": "Use monospace for code and identifiers, not as a general fintech costume. Keep a clear hierarchy through weight, scale and spacing.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "A new surface uses tonal separation and a border before considering any additional elevation treatment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the graphite/mint palette and flat working surfaces.",
      "Do show real application state with readable text and recovery actions.",
      "Do keep full wallet values accessible and allow long identifiers to wrap.",
      "Do inspect the actual mobile and desktop layouts after material changes.",
      "Do honor keyboard focus and reduced-motion preferences."
    ],
    "donts": [
      "Don't show fake balances, market decoration or inactive future navigation.",
      "Don't describe a stale or unavailable screening result as passed.",
      "Don't use gradients, halos or heavy shadows to replace useful content.",
      "Don't treat a successful build or a visual snapshot as proof of every user state."
    ]
  }
}
