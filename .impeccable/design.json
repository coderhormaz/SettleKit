      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:9px 12px;border:1px solid #475465;border-radius:7px;background:#19212a;color:#c7d5e5;font-family:var(--font-sans,Manrope,sans-serif);font-size:12px;font-weight:600;cursor:pointer;transition:background 150ms ease-out,border-color 150ms ease-out}.ds-button-secondary:hover:not(:disabled){background:#25303c;border-color:#64758b}.ds-button-secondary:focus-visible{outline:2px solid var(--mint,#a3f5c5);outline-offset:5px}.ds-button-secondary:active:not(:disabled){transform:translateY(1px)}.ds-button-secondary:disabled{opacity:.5;cursor:not-allowed}"
