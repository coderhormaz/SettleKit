{
  "name": "settlekit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @settlekit/gateway dev",
    "build": "pnpm --filter @settlekit/gateway build",
    "start": "pnpm --filter @settlekit/gateway start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "vitest run packages/db/test",
    "test:browser": "playwright test",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx --env-file=.env packages/db/src/migrate.ts",
    "screening:import": "tsx --env-file=.env packages/worker/src/import-screening.ts",
    "worker": "tsx --env-file=.env packages/worker/src/run.ts",
    "check:imports": "tsx scripts/check-imports.ts",
    "test:contracts": "pnpm --filter @settlekit/contracts test",
    "store": "pnpm --filter @settlekit/example-store start",
    "demo:setup": "tsx --env-file=.env scripts/setup-demo.ts",
    "policy:sync": "tsx --env-file=.env packages/worker/src/sync-policy.ts",
    "cre:compile": "tsx scripts/cre-recovery.ts",
    "accountant": "pnpm --filter @settlekit/accountant start",
    "db:restore": "tsx scripts/database-backup.ts restore",
    "cre:recover": "tsx scripts/cre-recovery.ts --simulate",
    "db:backup": "tsx scripts/database-backup.ts backup",
    "build:all": "pnpm --filter @settlekit/gateway build && pnpm --filter @settlekit/accountant build",
    "audit:secrets": "tsx scripts/check-secrets.ts",
    "stack": "tsx scripts/local-stack.ts",
    "recovery:demo": "tsx scripts/recovery-demo.ts",
    "receipts": "tsx scripts/public-receipts.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "dotenv": "17.2.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "viem": "2.57.16"
  }
}
